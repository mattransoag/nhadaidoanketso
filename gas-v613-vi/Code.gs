function dispatch612_(u,req){try{if(!req||typeof req.action!=='string')throw Error('INVALID_REQUEST');if(req.action==='auth.open')return {ok:true,data:open61_(u)};verify61_(u,req.token);if(req.action==='auth.close'){close61_(u,req.token);return {ok:true,data:true}};switch(req.action){case 'session':return {ok:true,data:u};case 'users.save':admin601_(u);return {ok:true,data:userSave61_(u,req)};case 'users.list':admin601_(u);return {ok:true,data:listUsers61_()};case 'units.list':return {ok:true,data:readV60_('Units').filter(x=>truthV60_(x.active)&&scopeV60_(u,x.id)).map(x=>({id:String(x.id),name:String(x.name)}))};case 'records.lookup':return {ok:true,data:lookup605_(u,req)};case 'records.deadline':return {ok:true,data:deadline605_(u,req)};case 'backup.zip':admin601_(u);return {ok:true,data:zip605_(u)};case 'records.importPreview':return {ok:true,data:import604_(u,req,false)};case 'records.importCommit':return {ok:true,data:import604_(u,req,true)};case 'backup.validate':admin601_(u);return {ok:true,data:validateBackup604_(req.backup)};case 'records.migrateCodes':admin601_(u);return {ok:true,data:migrate603_(u)};case 'records.detail':return {ok:true,data:detail603_(u,req)};case 'records.page':return {ok:true,data:page603_(u,req)};case 'health.check':admin601_(u);return {ok:true,data:health603_()};case 'records.list':return {ok:true,data:readV60_('Records').filter(r=>scopeV60_(u,r.unitId)).map(r=>({id:String(r.id),unitId:String(r.unitId),version:Number(r.version),data:JSON.parse(r.data)}))};case 'dashboard':case 'reports.summary':return {ok:true,data:reportV60_(u,req)};case 'workflow.submit':case 'workflow.review':return {ok:true,data:workflowV60_(u,req)};case 'records.create':case 'records.update':return {ok:true,data:saveV60_(u,req)};default:return {ok:true,data:dispatch601_(u,req)}}}catch(e){let msg=String(e.message);return {ok:false,error:/^[A-Z_]+$/.test(msg)?msg:'SERVER_ERROR'}}}
function saveV60_(u,req){if(!writerV60_(u))throw Error('FORBIDDEN');const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('BUSY');try{let input=req.data;if(!input||typeof input!=='object')throw Error('INVALID_REQUEST');let list=readV60_('Records'),old=req.action==='records.update'?list.find(r=>String(r.id)===String(req.id)):null;if(req.action==='records.update'&&(!old||!scopeV60_(u,old.unitId)))throw Error('NOT_FOUND');if(old&&Number(req.version)!==Number(old.version))throw Error('VERSION_CONFLICT');let unit=old?String(old.unitId):u.role==='UNIT_EDITOR'?u.unitId:cleanV60_(req.unitId,80);if(!scopeV60_(u,unit)||!readV60_('Units').some(x=>String(x.id)===unit&&truthV60_(x.active)))throw Error('FORBIDDEN');let data=old?JSON.parse(old.data):{approval:'DRAFT',trangThai:'Khảo sát / Phê duyệt',kinhPhiTinh:0,kinhPhiCoSo:0,doiUng:0,kinhPhiDaCap:0,kinhPhiGiaiNgan:0};if(old&&!['DRAFT','SUPPLEMENT'].includes(data.approval))throw Error('LOCKED');for(let k of ['hoTen','diaChi','dienThoai','doiTuong','hinhThuc','ghiChu'])if(Object.prototype.hasOwnProperty.call(input,k))data[k]=cleanV60_(input[k],k==='ghiChu'?1000:300);if(!data.hoTen||!data.diaChi)throw Error('REQUIRED_FIELDS');let id=old?String(old.id):'NDK-'+Utilities.getUuid(),version=old?Number(old.version)+1:1;data.maHoSo=id;data.donVi=unit;if(!data.ngayTiepNhan)data.ngayTiepNhan=Utilities.formatDate(new Date(),'Asia/Ho_Chi_Minh','yyyy-MM-dd');if(!data.code603)data.code603=next603_('NĐK-AG',data.ngayTiepNhan.slice(0,4),list.map(r=>JSON.parse(r.data).code603));let vals=[id,unit,version,JSON.stringify(data),new Date(),u.email];let sh=sheetV60_('Records');if(old)sh.getRange(old._row,1,1,vals.length).setValues([vals]);else sh.appendRow(vals);auditV60_(u,req.action,id,unit);return {id,unitId:unit,version,data}}finally{lock.releaseLock()}}

function reportV60_(u,req){let unit=String(req.unitId||''),year=String(req.year||''),month=String(req.month||''),quarter=String(req.quarter||'');if(quarter&&!/^[1-4]$/.test(quarter)||quarter&&month)throw Error('INVALID_PERIOD');if(unit&&!scopeV60_(u,unit))throw Error('FORBIDDEN');if(year&&!/^\d{4}$/.test(year)||month&&!/^(0[1-9]|1[0-2])$/.test(month))throw Error('INVALID_PERIOD');let a=readV60_('Records').filter(r=>scopeV60_(u,r.unitId)&&(!unit||String(r.unitId)===unit)).map(r=>({id:String(r.id),unitId:String(r.unitId),data:JSON.parse(r.data)})).filter(r=>{let d=r.data.ngayTiepNhan||'';return (!year||d.slice(0,4)===year)&&(!month||d.slice(5,7)===month)&&(!quarter||Math.ceil(Number(d.slice(5,7))/3)===Number(quarter))});let summary={count:a.length,approved:0,pending:0,done:0,support:0,paid:0};for(let r of a){let d=r.data;summary.approved+=Number(d.approval==='APPROVED');summary.pending+=Number(['REVIEW','PENDING'].includes(d.approval));summary.done+=Number(d.trangThai==='Đã nghiệm thu, bàn giao');summary.support+=Number(d.kinhPhiTinh||0)+Number(d.kinhPhiCoSo||0);summary.paid+=Number(d.kinhPhiGiaiNgan||0)}return {summary,records:a,period:{unitId:unit,year,month,quarter}}}
function workflowV60_(u,req){if(!writerV60_(u))throw Error('FORBIDDEN');const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('BUSY');try{let r=readV60_('Records').find(x=>String(x.id)===String(req.id));if(!r||!scopeV60_(u,r.unitId))throw Error('NOT_FOUND');if(Number(req.version)!==Number(r.version))throw Error('VERSION_CONFLICT');let d=JSON.parse(r.data);if(req.action==='workflow.submit'){if(!['DRAFT','SUPPLEMENT'].includes(d.approval))throw Error('INVALID_STATE');d.approval='REVIEW'}else{if(!['SUPER_ADMIN','PROVINCE_ADMIN'].includes(u.role))throw Error('FORBIDDEN');if(d.approval!=='REVIEW')throw Error('INVALID_STATE');if(!['APPROVED','SUPPLEMENT'].includes(req.decision))throw Error('INVALID_REQUEST');d.approval=req.decision;if(req.decision==='SUPPLEMENT'){d.reviewNote=cleanV60_(req.note,1000);if(!d.reviewNote)throw Error('REQUIRED_FIELDS')}else{d.trangThai='Đã phê duyệt';d.ngayDuyet=Utilities.formatDate(new Date(),'Asia/Ho_Chi_Minh','yyyy-MM-dd')}}if(req.decision==='APPROVED')d.approvalCode603=next603_('QĐ',today601_().slice(0,4));let version=Number(r.version)+1;sheetV60_('Records').getRange(r._row,3,1,4).setValues([[version,JSON.stringify(d),new Date(),u.email]]);auditV60_(u,req.action,r.id,r.unitId);return {id:String(r.id),version,data:d}}finally{lock.releaseLock()}}

