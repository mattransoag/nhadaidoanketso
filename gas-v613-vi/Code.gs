case 'completion.accept':case 'completion.handover':case 'completion.settle':case 'completion.archive':province601_(u);return lock601_(()=>{let {r,d}=rec601_(u,q,false);if(Number(q.version)!==Number(r.version)||d.archived)throw Error('LOCKED_OR_CONFLICT');if(d.approval!=='APPROVED')throw Error('INVALID_STATE');let date=date601_(q.date),ref=text601_(q.ref,100);if(date>today601_()||!ref)throw Error('INVALID_REQUEST');let ev=readV60_('Evidence').filter(x=>String(x.recordId)===String(r.id));if(q.action==='completion.accept'){if(d.settlement56||d.ngayNghiemThu||d.progress53!==100||!d.ngayKhoiCong||date<d.ngayKhoiCong||!ev.length)throw Error('INVALID_STATE');d.ngayNghiemThu=date;d.accept561={date,ref,result:'pass',code:next603_('NT',date.slice(0,4))}}else if(q.action==='completion.handover'){if(!d.ngayNghiemThu||d.ngayBanGiao||date<d.ngayNghiemThu)throw Error('INVALID_STATE');d.ngayBanGiao=date;d.handover561={date,ref,code:next603_('BG',date.slice(0,4))};d.trangThai='Đã nghiệm thu, bàn giao'}else if(q.action==='completion.settle'){if(!d.ngayBanGiao||d.settlement56||date<d.ngayBanGiao||Number(d.kinhPhiDaCap||0)!==Number(d.kinhPhiGiaiNgan||0)||Number(d.kinhPhiTinh||0)+Number(d.kinhPhiCoSo||0)!==Number(d.kinhPhiGiaiNgan||0))throw Error('INVALID_STATE');checkLedger605_(r,d);d.settlement56={date,ref,code:next603_('QT',date.slice(0,4))}}else{if(!d.settlement56||date<d.settlement56.date)throw Error('INVALID_STATE');d.archived=true;d.archive561={date,ref,code:next603_('LT',date.slice(0,4))}}return save601_(u,r,d,q.action)});
