function sameVI613_(a,b){return JSON.stringify(a)===JSON.stringify(b)}
function guardVI613_(){let p=PropertiesService.getScriptProperties(),id=p.getProperty('SPREADSHEET_ID'),ss=SpreadsheetApp.getActiveSpreadsheet(),a=String(Session.getActiveUser().getEmail()||'').toLowerCase(),b=String(Session.getEffectiveUser().getEmail()||'').toLowerCase();if(!a||a!==b||!id||id!==p.getProperty('DEMO_SPREADSHEET_ID')||p.getProperty('DIRECT_DEMO_ENABLED')!=='FALSE'||!ss||ss.getId()!==id||!ss.getName().includes('V6.1.3 TEST'))throw Error('Chỉ chạy trong bảng tính V6.1.3 TEST riêng, API phải tắt.');return ss}
function migrateVI613_(){return lock601_(()=>{let ss=guardVI613_(),items=[];for(let [n,[vn,head]] of Object.entries(VI613)){let a=ss.getSheetByName(n),b=ss.getSheetByName(vn);if(a&&b)throw Error('Trùng bảng: '+n);let s=a||b;if(!s)throw Error('Thiếu bảng: '+n);let old=s.getRange(1,1,1,head.length).getValues()[0];if(!sameVI613_(old,V60_SCHEMA[n])&&!sameVI613_(old,head))throw Error('Sai tiêu đề: '+n);items.push({n,vn,head,s,count:s.getLastRow()})}let guide=ss.getSheetByName('Hướng dẫn quản trị');if(guide&&guide.getRange('A1').getValue()!=='HƯỚNG DẪN QUẢN TRỊ — V6.1.3 TEST')throw Error('Trùng tên trang hướng dẫn');for(let {n,vn,head,s} of items){if(s.getName()!==vn)s.setName(vn);let r=s.getRange(1,1,1,head.length);r.setValues([head]).setBackground('#A30F12').setFontColor('#FFFFFF').setFontWeight('bold').setWrap(true).setVerticalAlignment('middle');s.getRange(1,1,s.getMaxRows(),head.length).setFontFamily('Roboto');s.setFrozenRows(1);s.setRowHeight(1,42);s.setTabColor(['Units','Users','Config','Audit'].includes(n)?'#A30F12':['Transactions','Plans'].includes(n)?'#D4A017':'#B91C1C');for(let i=0;i<head.length;i++){let k=V60_SCHEMA[n][i];s.setColumnWidth(i+1,k==='data'?440:k==='email'||k==='updatedBy'||k==='actor'||k==='id'||k==='recordId'||k==='fileId'?250:170);let body=s.getRange(2,i+1,s.getMaxRows()-1,1);if(k==='amount')body.setNumberFormat('#,##0" đ"');if(k==='time'||k==='updatedAt')body.setNumberFormat('dd/mm/yyyy hh:mm:ss');if(k==='date')body.setNumberFormat('dd/mm/yyyy');}let label='NDK-VI613-WARNING';if(!s.getProtections(SpreadsheetApp.ProtectionType.SHEET).some(p=>p.getDescription()===label))s.protect().setDescription(label).setWarningOnly(true);if(s.getLastRow()!==items.find(x=>x.n===n).count)throw Error('Số hàng thay đổi bất thường: '+n)}
if(!guide)guide=ss.insertSheet('Hướng dẫn quản trị');let rows=[['HƯỚNG DẪN QUẢN TRỊ — V6.1.3 TEST',''],['Phạm vi','Chỉ dữ liệu giả lập. Không dùng dữ liệu thật.'],['Vận hành','Nhập liệu và báo cáo trên website GitHub.'],['Bảo mật','Không chia sẻ bảng tính hoặc thư mục minh chứng công khai.'],['Cấu trúc','Tên bảng và tiêu đề tiếng Việt; khóa API, vai trò, UUID và JSON giữ nguyên.'],['Cảnh báo','Không đổi thứ tự cột, không sửa UUID, không đổi tên bảng thủ công.'],['Bảo vệ','Cảnh báo khi sửa trực tiếp; không thay thế phân quyền máy chủ.'],['Sao lưu','Tạo bản sao riêng trước khi thay đổi cấu trúc.'],['Bảng dữ liệu','Tên kỹ thuật (không đổi trong API)'],...Object.entries(VI613).map(([k,v])=>[v[0],k])];guide.getRange(1,1,rows.length,2).setValues(rows).setFontFamily('Roboto').setWrap(true).setVerticalAlignment('middle');guide.getRange(1,1,1,2).setBackground('#A30F12').setFontColor('#FFFFFF').setFontWeight('bold');guide.getRange(9,1,1,2).setBackground('#FFE7A3').setFontWeight('bold');guide.setColumnWidth(1,280);guide.setColumnWidth(2,650);guide.setFrozenRows(1);guide.setTabColor('#D4A017');ss.setActiveSheet(guide);SpreadsheetApp.flush();return items.map(x=>({table:x.vn,rows:x.count-1}))})}
