function gatewayIdentity612_(email){let p=PropertiesService.getScriptProperties();if(p.getProperty('PILOT_ENABLED')!=='TRUE'||p.getProperty('GATEWAY_DEMO_ENABLED')!=='TRUE')throw Error('GATEWAY_DISABLED');let a=readV60_('Users').filter(x=>String(x.email).trim().toLowerCase()===email&&truthV60_(x.active));if(a.length!==1||!V60_ROLES.includes(a[0].role))throw Error('FORBIDDEN');let u={email,role:a[0].role,unitId:String(a[0].unitId||'')};if(u.role.startsWith('UNIT_')&&!readV60_('Units').some(x=>String(x.id)===u.unitId&&truthV60_(x.active)))throw Error('FORBIDDEN');return u}
function equal612_(a,b){if(typeof a!=='string'||typeof b!=='string'||a.length!==b.length)return false;let n=0;for(let i=0;i<a.length;i++)n|=a.charCodeAt(i)^b.charCodeAt(i);return n===0}
function signedPost612_(e){let result;try{let p=PropertiesService.getScriptProperties(),secret=p.getProperty('GATEWAY_SECRET');if(p.getProperty('GATEWAY_DEMO_ENABLED')!=='TRUE'||p.getProperty('PILOT_ENABLED')!=='TRUE'||!secret||secret.length<43)throw Error('GATEWAY_DISABLED');let raw=e&&e.postData&&e.postData.contents;if(typeof raw!=='string'||raw.length>17000000)throw Error('INVALID_REQUEST');let w=JSON.parse(raw);if(typeof w.payload!=='string'||typeof w.sig!=='string')throw Error('INVALID_REQUEST');let sig=Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(w.payload,secret)).replace(/=+$/,'');if(!equal612_(sig,w.sig))throw Error('FORBIDDEN');let q=JSON.parse(w.payload);if(!Number.isSafeInteger(q.ts)||Math.abs(Date.now()-q.ts)>30000||!/^[a-f0-9-]{36}$/.test(q.nonce)||typeof q.email!=='string'||!q.req||typeof q.req.action!=='string')throw Error('INVALID_REQUEST');lock601_(()=>{let cache=CacheService.getScriptCache(),key='gw612:'+q.nonce;if(cache.get(key))throw Error('REPLAY');cache.put(key,'1',120)});result=dispatch612_(gatewayIdentity612_(q.email.trim().toLowerCase()),q.req)}catch(e){result=error612_(e)}return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON)}

/* Direct GitHub pilot. Separate synthetic spreadsheet/project only.
   Google tokeninfo is a diagnostic validation endpoint, not a production SLA.
   Only Google-authoritative identities (Gmail or verified Workspace domain).
   Explicit subject enrollment prevents email reassignment from granting access. */
function directIdentity613_(credential){let p=PropertiesService.getScriptProperties(),client=p.getProperty('GOOGLE_CLIENT_ID'),domain=p.getProperty('GOOGLE_HOSTED_DOMAIN');if(p.getProperty('DIRECT_DEMO_ENABLED')!=='TRUE'||p.getProperty('PILOT_ENABLED')!=='TRUE'||!client||p.getProperty('DEMO_SPREADSHEET_ID')!==p.getProperty('SPREADSHEET_ID'))throw Error('DIRECT_DISABLED');if(typeof credential!=='string'||credential.length>10000||!/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(credential))throw Error('UNAUTHENTICATED');let res=UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo?id_token='+encodeURIComponent(credential),{muteHttpExceptions:true,followRedirects:false});if(res.getResponseCode()!==200)throw Error('UNAUTHENTICATED');let v=JSON.parse(res.getContentText()),now=Math.floor(Date.now()/1000);if(v.aud!==client||!['accounts.google.com','https://accounts.google.com'].includes(v.iss)||String(v.email_verified)!=='true'||!Number.isFinite(Number(v.exp))||Number(v.exp)<=now||typeof v.email!=='string'||typeof v.sub!=='string'||!/^\d{1,64}$/.test(v.sub))throw Error('UNAUTHENTICATED');let email=v.email.trim().toLowerCase();if(domain?v.hd!==domain:!email.endsWith('@gmail.com'))throw Error('FORBIDDEN');if(p.getProperty('SUB613_'+email)!==v.sub)throw Error('ACCOUNT_NOT_ENROLLED');let a=readV60_('Users').filter(x=>String(x.email).trim().toLowerCase()===email&&truthV60_(x.active));if(a.length!==1||!V60_ROLES.includes(a[0].role))throw Error('FORBIDDEN');let u={email,role:a[0].role,unitId:String(a[0].unitId||'')};if(u.role.startsWith('UNIT_')&&!readV60_('Units').some(x=>String(x.id)===u.unitId&&truthV60_(x.active)))throw Error('FORBIDDEN');return u}
function doPost(e){let result;try{let raw=e&&e.postData&&e.postData.contents;if(typeof raw!=='string'||raw.length>16000000)throw Error('INVALID_REQUEST');let q=JSON.parse(raw);if(q.protocol!=='6.1.3')throw Error('INVALID_REQUEST');let u=directIdentity613_(q.credential);if(!q.req||typeof q.req.action!=='string')throw Error('INVALID_REQUEST');result=dispatch612_(u,q.req)}catch(e){result=error612_(e)}return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON)}

