function sheetV60_(n){let ss=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID')),m=VI613[n];if(!m)throw Error('UNKNOWN_TABLE');let a=ss.getSheetByName(n),b=ss.getSheetByName(m[0]);if(a&&b)throw Error('DUPLICATE_TABLE');let s=b||a;if(!s)throw Error('MISSING_TABLE');let headers=s.getRange(1,1,1,V60_SCHEMA[n].length).getValues()[0];if(!sameVI613_(headers,V60_SCHEMA[n])&&!sameVI613_(headers,m[1]))throw Error('SCHEMA_MISMATCH');return s}
