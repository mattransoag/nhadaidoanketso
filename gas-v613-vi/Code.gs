function dispatch601_(u,q){switch(q.action){
case 'progress.save':return lock601_(()=>{let {r,d}=rec601_(u,q,true);if(d.approval!=='APPROVED'||d.ngayNghiemThu)throw Error('INVALID_STATE');let n=amount601_(q.progress);if(n>100||n<Number(d.progress53||0))throw Error('INVALID_PROGRESS');let date=date601_(q.date);if(date>today601_()||d.ngayDuyet&&date<d.ngayDuyet||d.ngayKhoiCong&&date<d.ngayKhoiCong)throw Error('INVALID_DATE');d.ngayKhoiCong=d.ngayKhoiCong||date;d.progress53=n;d.trangThai=n===100?'Chờ nghiệm thu':'Đang thi công';return save601_(u,r,d,q.action)});
case 'finance.budget':province601_(u);return lock601_(()=>{let {r,d}=rec601_(u,q,true);if(d.approval!=='APPROVED')throw Error('INVALID_STATE');let t=amount601_(q.tinh),c=amount601_(q.coSo),o=amount601_(q.doiUng);if(t+c<Number(d.kinhPhiDaCap||0))throw Error('EXCEEDS_BUDGET');Object.assign(d,{kinhPhiTinh:t,kinhPhiCoSo:c,doiUng:o});return save601_(u,r,d,q.action)});
