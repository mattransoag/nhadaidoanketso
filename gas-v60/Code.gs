/**
 * V6.0 pilot backend. Owner-only pilot initially. Domain-only deployment may be evaluated later.
 * Do not grant users direct spreadsheet access; never deploy anonymously.
 * Run setupV60 manually as spreadsheet administrator; no public setup endpoint.
 */
const V60_SCHEMA={Units:['id','name','active'],Users:['email','role','unitId','active'],Records:['id','unitId','version','data','updatedAt','updatedBy'],Audit:['time','email','unitId','action','recordId'],Transactions:['id','recordId','unitId','kind','amount','date','ref','actor'],Evidence:['id','recordId','unitId','fileId','name','mime','size'],Plans:['id','unitId','year','target'],Tasks:['id','unitId','data'],Reports:['id','unitId','period','revision','data','status'],Config:['key','value']};
const V60_ROLES=['SUPER_ADMIN','PROVINCE_ADMIN','PROVINCE_VIEWER','UNIT_EDITOR','UNIT_VIEWER'];
function setupV60_(){const p=PropertiesService.getScriptProperties(),id=p.getProperty('SPREADSHEET_ID');if(!id)throw Error('Set SPREADSHEET_ID in Script Properties first');const ss=SpreadsheetApp.openById(id);Object.keys(V60_SCHEMA).forEach(n=>{let sh=ss.getSheetByName(n);if(!sh){sh=ss.insertSheet(n);sh.getRange(1,1,1,V60_SCHEMA[n].length).setValues([V60_SCHEMA[n]]);sh.setFrozenRows(1)}else if(JSON.stringify(sh.getRange(1,1,1,V60_SCHEMA[n].length).getValues()[0])!==JSON.stringify(V60_SCHEMA[n]))throw Error('Schema mismatch: '+n)});}
function sheetV60_(n){return SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID')).getSheetByName(n)}
function readV60_(n){let s=sheetV60_(n),h=V60_SCHEMA[n];if(!s||s.getLastRow()<2)return [];return s.getRange(2,1,s.getLastRow()-1,h.length).getValues().map((a,i)=>Object.assign({_row:i+2},Object.fromEntries(h.map((k,j)=>[k,a[j]]))))}
function truthV60_(x){return x===true||String(x).toLowerCase()==='true'}
function identityV60_(){const props=PropertiesService.getScriptProperties();if(props.getProperty('PILOT_ENABLED')!=='TRUE')throw Error('PILOT_DISABLED');let email=String(Session.getActiveUser().getEmail()||'').trim().toLowerCase();if(!email)throw Error('UNAUTHENTICATED');const owner=String(Session.getEffectiveUser().getEmail()||'').toLowerCase();if(email!==owner)throw Error('PILOT_OWNER_ONLY');let matches=readV60_('Users').filter(u=>String(u.email).trim().toLowerCase()===email&&truthV60_(u.active));if(matches.length!==1||!V60_ROLES.includes(matches[0].role))throw Error('FORBIDDEN');let u=matches[0];if(u.role.indexOf('UNIT_')===0&&!readV60_('Units').some(x=>String(x.id)===String(u.unitId)&&truthV60_(x.active)))throw Error('FORBIDDEN');return {email,role:u.role,unitId:String(u.unitId||'')}}
function scopeV60_(u,unit){return u.role.indexOf('UNIT_')!==0||u.unitId===String(unit)}
function writerV60_(u){return ['SUPER_ADMIN','PROVINCE_ADMIN','UNIT_EDITOR'].includes(u.role)}
function cleanV60_(v,max){if(typeof v!=='string'||v.trim().length>max)throw Error('INVALID_TEXT');return v.trim()}
function auditV60_(u,a,id,unit){sheetV60_('Audit').appendRow([new Date(),u.email,String(unit||u.unitId),a,String(id||'')])}
function doGet(){return HtmlService.createHtmlOutputFromFile('Portal').setTitle('Nhà Đại đoàn kết số V6.0 — thử nghiệm kết nối')}
function apiV60(req){try{const u=identityV60_();if(!req||typeof req.action!=='string')throw Error('INVALID_REQUEST');switch(req.action){case 'session':return {ok:true,data:u};case 'units.list':return {ok:true,data:readV60_('Units').filter(x=>truthV60_(x.active)&&scopeV60_(u,x.id)).map(x=>({id:String(x.id),name:String(x.name)}))};case 'records.list':return {ok:true,data:readV60_('Records').filter(r=>scopeV60_(u,r.unitId)).map(r=>({id:String(r.id),unitId:String(r.unitId),version:Number(r.version),data:JSON.parse(r.data)}))};case 'dashboard':case 'reports.summary':return {ok:true,data:reportV60_(u,req)};case 'workflow.submit':case 'workflow.review':return {ok:true,data:workflowV60_(u,req)};case 'records.create':case 'records.update':return {ok:true,data:saveV60_(u,req)};default:throw Error('NOT_IMPLEMENTED')}}catch(e){let msg=String(e.message);return {ok:false,error:/^[A-Z_]+$/.test(msg)?msg:'SERVER_ERROR'}}}
function saveV60_(u,req){if(!writerV60_(u))throw Error('FORBIDDEN');const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('BUSY');try{let input=req.data;if(!input||typeof input!=='object')throw Error('INVALID_REQUEST');let list=readV60_('Records'),old=req.action==='records.update'?list.find(r=>String(r.id)===String(req.id)):null;if(req.action==='records.update'&&(!old||!scopeV60_(u,old.unitId)))throw Error('NOT_FOUND');if(old&&Number(req.version)!==Number(old.version))throw Error('VERSION_CONFLICT');let unit=old?String(old.unitId):u.role==='UNIT_EDITOR'?u.unitId:cleanV60_(req.unitId,80);if(!scopeV60_(u,unit)||!readV60_('Units').some(x=>String(x.id)===unit&&truthV60_(x.active)))throw Error('FORBIDDEN');let data=old?JSON.parse(old.data):{approval:'DRAFT',trangThai:'Khảo sát / Phê duyệt',kinhPhiTinh:0,kinhPhiCoSo:0,doiUng:0,kinhPhiDaCap:0,kinhPhiGiaiNgan:0};if(old&&!['DRAFT','SUPPLEMENT'].includes(data.approval))throw Error('LOCKED');for(let k of ['hoTen','diaChi','dienThoai','doiTuong','hinhThuc','ghiChu'])if(Object.prototype.hasOwnProperty.call(input,k))data[k]=cleanV60_(input[k],k==='ghiChu'?1000:300);if(!data.hoTen||!data.diaChi)throw Error('REQUIRED_FIELDS');let id=old?String(old.id):'NDK-'+Utilities.getUuid(),version=old?Number(old.version)+1:1;data.maHoSo=id;data.donVi=unit;if(!data.ngayTiepNhan)data.ngayTiepNhan=Utilities.formatDate(new Date(),'Asia/Ho_Chi_Minh','yyyy-MM-dd');let vals=[id,unit,version,JSON.stringify(data),new Date(),u.email];let sh=sheetV60_('Records');if(old)sh.getRange(old._row,1,1,vals.length).setValues([vals]);else sh.appendRow(vals);auditV60_(u,req.action,id,unit);return {id,unitId:unit,version,data}}finally{lock.releaseLock()}}

function reportV60_(u,req){let unit=String(req.unitId||''),year=String(req.year||''),month=String(req.month||'');if(unit&&!scopeV60_(u,unit))throw Error('FORBIDDEN');if(year&&!/^\d{4}$/.test(year)||month&&!/^(0[1-9]|1[0-2])$/.test(month))throw Error('INVALID_PERIOD');let a=readV60_('Records').filter(r=>scopeV60_(u,r.unitId)&&(!unit||String(r.unitId)===unit)).map(r=>({id:String(r.id),unitId:String(r.unitId),data:JSON.parse(r.data)})).filter(r=>{let d=r.data.ngayTiepNhan||'';return (!year||d.slice(0,4)===year)&&(!month||d.slice(5,7)===month)});let summary={count:a.length,approved:0,pending:0,done:0,support:0,paid:0};for(let r of a){let d=r.data;summary.approved+=Number(d.approval==='APPROVED');summary.pending+=Number(['REVIEW','PENDING'].includes(d.approval));summary.done+=Number(d.trangThai==='Đã nghiệm thu, bàn giao');summary.support+=Number(d.kinhPhiTinh||0)+Number(d.kinhPhiCoSo||0);summary.paid+=Number(d.kinhPhiGiaiNgan||0)}return {summary,records:a,period:{unitId:unit,year,month}}}
function workflowV60_(u,req){if(!writerV60_(u))throw Error('FORBIDDEN');const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('BUSY');try{let r=readV60_('Records').find(x=>String(x.id)===String(req.id));if(!r||!scopeV60_(u,r.unitId))throw Error('NOT_FOUND');if(Number(req.version)!==Number(r.version))throw Error('VERSION_CONFLICT');let d=JSON.parse(r.data);if(req.action==='workflow.submit'){if(!['DRAFT','SUPPLEMENT'].includes(d.approval))throw Error('INVALID_STATE');d.approval='REVIEW'}else{if(!['SUPER_ADMIN','PROVINCE_ADMIN'].includes(u.role))throw Error('FORBIDDEN');if(d.approval!=='REVIEW')throw Error('INVALID_STATE');if(!['APPROVED','SUPPLEMENT'].includes(req.decision))throw Error('INVALID_REQUEST');d.approval=req.decision;if(req.decision==='SUPPLEMENT'){d.reviewNote=cleanV60_(req.note,1000);if(!d.reviewNote)throw Error('REQUIRED_FIELDS')}else{d.trangThai='Đã phê duyệt';d.ngayDuyet=Utilities.formatDate(new Date(),'Asia/Ho_Chi_Minh','yyyy-MM-dd')}}let version=Number(r.version)+1;sheetV60_('Records').getRange(r._row,3,1,4).setValues([[version,JSON.stringify(d),new Date(),u.email]]);auditV60_(u,req.action,r.id,r.unitId);return {id:String(r.id),version,data:d}}finally{lock.releaseLock()}}
