/**
 * V6.0 pilot backend. Owner-only pilot initially. Domain-only deployment may be evaluated later.
 * Do not grant users direct spreadsheet access; never deploy anonymously.
 * Run setupV60 manually as spreadsheet administrator; no public setup endpoint.
 */
const V60_SCHEMA={Units:['id','name','active'],Users:['email','role','unitId','active'],Records:['id','unitId','version','data','updatedAt','updatedBy'],Audit:['time','email','unitId','action','recordId'],Transactions:['id','recordId','unitId','kind','amount','date','ref','actor'],Evidence:['id','recordId','unitId','fileId','name','mime','size'],Plans:['id','unitId','year','target'],Tasks:['id','unitId','data'],Reports:['id','unitId','period','revision','data','status'],Config:['key','value']};
const V60_ROLES=['SUPER_ADMIN','PROVINCE_ADMIN','PROVINCE_VIEWER','UNIT_EDITOR','UNIT_VIEWER'];
function setupV60_(){const p=PropertiesService.getScriptProperties(),id=p.getProperty('SPREADSHEET_ID');if(!id)throw Error('Set SPREADSHEET_ID in Script Properties first');const ss=SpreadsheetApp.openById(id);Object.keys(V60_SCHEMA).forEach(n=>{let sh=ss.getSheetByName(n);if(!sh){sh=ss.insertSheet(n);sh.getRange(1,1,1,V60_SCHEMA[n].length).setValues([V60_SCHEMA[n]]);sh.setFrozenRows(1)}else if(JSON.stringify(sh.getRange(1,1,1,V60_SCHEMA[n].length).getValues()[0])!==JSON.stringify(V60_SCHEMA[n]))throw Error('Schema mismatch: '+n)});}
function sheetV60_(n){return SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID')).getSheetByName(n)}
function readV60_(n){let s=sheetV60_(n),h=V60_SCHEMA[n];if(!s||s.getLastRow()<2)return [];return s.getRange(2,1,s.getLastRow()-1,h.length).getValues().map((a,i)=>Object.assign({_row:i+2},Object.fromEntries(h.map((k,j)=>[k,a[j]]))))}
function truthV60_(x){return x===true||String(x).toLowerCase()==='true'}
function identityV60_(){const props=PropertiesService.getScriptProperties();if(props.getProperty('PILOT_ENABLED')!=='TRUE')throw Error('PILOT_DISABLED');let email=String(Session.getActiveUser().getEmail()||'').trim().toLowerCase();if(!email)throw Error('UNAUTHENTICATED');const owner=String(Session.getEffectiveUser().getEmail()||'').toLowerCase();if(email!==owner)throw Error('PILOT_OWNER_ONLY');let matches=readV60_('Users').filter(u=>String(u.email).trim().toLowerCase()===email&&truthV60_(u.active));if(matches.length!==1||!V60_ROLES.includes(matches[0].role))throw Error('FORBIDDEN');let u=matches[0];if(u.role.indexOf('UNIT_')===0&&!readV60_('Units').some(x=>String(x.id)===String(u.unitId)&&truthV60_(x.active)))throw Error('FORBIDDEN');return {email,role:u.role,unitId:String(u.unitId||'')}}
function scopeV60_(u,unit){return u.role.indexOf('UNIT_')!==0||u.unitId===String(unit)}
function writerV60_(u){return ['SUPER_ADMIN','PROVINCE_ADMIN','UNIT_EDITOR'].includes(u.role)}
function cleanV60_(v,max){if(typeof v!=='string'||v.trim().length>max)throw Error('INVALID_TEXT');return v.trim()}
function auditV60_(u,a,id,unit){sheetV60_('Audit').appendRow([new Date(),u.email,String(unit||u.unitId),a,String(id||'')])}
function doGet(e){return HtmlService.createHtmlOutputFromFile('Portal').setTitle('Nhà Đại đoàn kết số V6.0.2 — thử nghiệm')}
function apiV60(req){try{const u=identityV60_();if(!req||typeof req.action!=='string')throw Error('INVALID_REQUEST');switch(req.action){case 'session':return {ok:true,data:u};case 'units.list':return {ok:true,data:readV60_('Units').filter(x=>truthV60_(x.active)&&scopeV60_(u,x.id)).map(x=>({id:String(x.id),name:String(x.name)}))};case 'records.list':return {ok:true,data:readV60_('Records').filter(r=>scopeV60_(u,r.unitId)).map(r=>({id:String(r.id),unitId:String(r.unitId),version:Number(r.version),data:JSON.parse(r.data)}))};case 'dashboard':case 'reports.summary':return {ok:true,data:reportV60_(u,req)};case 'workflow.submit':case 'workflow.review':return {ok:true,data:workflowV60_(u,req)};case 'records.create':case 'records.update':return {ok:true,data:saveV60_(u,req)};default:return {ok:true,data:dispatch601_(u,req)}}}catch(e){let msg=String(e.message);return {ok:false,error:/^[A-Z_]+$/.test(msg)?msg:'SERVER_ERROR'}}}
function saveV60_(u,req){if(!writerV60_(u))throw Error('FORBIDDEN');const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('BUSY');try{let input=req.data;if(!input||typeof input!=='object')throw Error('INVALID_REQUEST');let list=readV60_('Records'),old=req.action==='records.update'?list.find(r=>String(r.id)===String(req.id)):null;if(req.action==='records.update'&&(!old||!scopeV60_(u,old.unitId)))throw Error('NOT_FOUND');if(old&&Number(req.version)!==Number(old.version))throw Error('VERSION_CONFLICT');let unit=old?String(old.unitId):u.role==='UNIT_EDITOR'?u.unitId:cleanV60_(req.unitId,80);if(!scopeV60_(u,unit)||!readV60_('Units').some(x=>String(x.id)===unit&&truthV60_(x.active)))throw Error('FORBIDDEN');let data=old?JSON.parse(old.data):{approval:'DRAFT',trangThai:'Khảo sát / Phê duyệt',kinhPhiTinh:0,kinhPhiCoSo:0,doiUng:0,kinhPhiDaCap:0,kinhPhiGiaiNgan:0};if(old&&!['DRAFT','SUPPLEMENT'].includes(data.approval))throw Error('LOCKED');for(let k of ['hoTen','diaChi','dienThoai','doiTuong','hinhThuc','ghiChu'])if(Object.prototype.hasOwnProperty.call(input,k))data[k]=cleanV60_(input[k],k==='ghiChu'?1000:300);if(!data.hoTen||!data.diaChi)throw Error('REQUIRED_FIELDS');let id=old?String(old.id):'NDK-'+Utilities.getUuid(),version=old?Number(old.version)+1:1;data.maHoSo=id;data.donVi=unit;if(!data.ngayTiepNhan)data.ngayTiepNhan=Utilities.formatDate(new Date(),'Asia/Ho_Chi_Minh','yyyy-MM-dd');let vals=[id,unit,version,JSON.stringify(data),new Date(),u.email];let sh=sheetV60_('Records');if(old)sh.getRange(old._row,1,1,vals.length).setValues([vals]);else sh.appendRow(vals);auditV60_(u,req.action,id,unit);return {id,unitId:unit,version,data}}finally{lock.releaseLock()}}

function reportV60_(u,req){let unit=String(req.unitId||''),year=String(req.year||''),month=String(req.month||'');if(unit&&!scopeV60_(u,unit))throw Error('FORBIDDEN');if(year&&!/^\d{4}$/.test(year)||month&&!/^(0[1-9]|1[0-2])$/.test(month))throw Error('INVALID_PERIOD');let a=readV60_('Records').filter(r=>scopeV60_(u,r.unitId)&&(!unit||String(r.unitId)===unit)).map(r=>({id:String(r.id),unitId:String(r.unitId),data:JSON.parse(r.data)})).filter(r=>{let d=r.data.ngayTiepNhan||'';return (!year||d.slice(0,4)===year)&&(!month||d.slice(5,7)===month)});let summary={count:a.length,approved:0,pending:0,done:0,support:0,paid:0};for(let r of a){let d=r.data;summary.approved+=Number(d.approval==='APPROVED');summary.pending+=Number(['REVIEW','PENDING'].includes(d.approval));summary.done+=Number(d.trangThai==='Đã nghiệm thu, bàn giao');summary.support+=Number(d.kinhPhiTinh||0)+Number(d.kinhPhiCoSo||0);summary.paid+=Number(d.kinhPhiGiaiNgan||0)}return {summary,records:a,period:{unitId:unit,year,month}}}
function workflowV60_(u,req){if(!writerV60_(u))throw Error('FORBIDDEN');const lock=LockService.getScriptLock();if(!lock.tryLock(10000))throw Error('BUSY');try{let r=readV60_('Records').find(x=>String(x.id)===String(req.id));if(!r||!scopeV60_(u,r.unitId))throw Error('NOT_FOUND');if(Number(req.version)!==Number(r.version))throw Error('VERSION_CONFLICT');let d=JSON.parse(r.data);if(req.action==='workflow.submit'){if(!['DRAFT','SUPPLEMENT'].includes(d.approval))throw Error('INVALID_STATE');d.approval='REVIEW'}else{if(!['SUPER_ADMIN','PROVINCE_ADMIN'].includes(u.role))throw Error('FORBIDDEN');if(d.approval!=='REVIEW')throw Error('INVALID_STATE');if(!['APPROVED','SUPPLEMENT'].includes(req.decision))throw Error('INVALID_REQUEST');d.approval=req.decision;if(req.decision==='SUPPLEMENT'){d.reviewNote=cleanV60_(req.note,1000);if(!d.reviewNote)throw Error('REQUIRED_FIELDS')}else{d.trangThai='Đã phê duyệt';d.ngayDuyet=Utilities.formatDate(new Date(),'Asia/Ho_Chi_Minh','yyyy-MM-dd')}}let version=Number(r.version)+1;sheetV60_('Records').getRange(r._row,3,1,4).setValues([[version,JSON.stringify(d),new Date(),u.email]]);auditV60_(u,req.action,r.id,r.unitId);return {id:String(r.id),version,data:d}}finally{lock.releaseLock()}}

/* V6.0.1 owner-only pilot. No anonymous access, no real data. */
const today601_=()=>Utilities.formatDate(new Date(),'Asia/Ho_Chi_Minh','yyyy-MM-dd');
function province601_(u){if(!['SUPER_ADMIN','PROVINCE_ADMIN'].includes(u.role))throw Error('FORBIDDEN')}
function admin601_(u){if(u.role!=='SUPER_ADMIN')throw Error('FORBIDDEN')}
function lock601_(fn){const l=LockService.getScriptLock();if(!l.tryLock(10000))throw Error('BUSY');try{return fn()}finally{l.releaseLock()}}
function date601_(s){if(typeof s!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(s)||!Number.isFinite(Date.parse(s))||new Date(s).toISOString().slice(0,10)!==s)throw Error('INVALID_DATE');return s}
function amount601_(n){if(typeof n!=='number'||!Number.isSafeInteger(n)||n<0||n>999999999999)throw Error('INVALID_AMOUNT');return n}
function id601_(s){if(typeof s!=='string'||!/^[A-Za-z0-9_-]{1,100}$/.test(s))throw Error('INVALID_ID');return s}
function text601_(s,n){let v=cleanV60_(s,n);if(/^[=+@-]/.test(v))throw Error('INVALID_TEXT');return v}
function rec601_(u,q,write){let r=readV60_('Records').find(x=>String(x.id)===String(q.id));if(!r||!scopeV60_(u,r.unitId))throw Error('NOT_FOUND');if(write&&(!writerV60_(u)||Number(q.version)!==Number(r.version)))throw Error('FORBIDDEN_OR_CONFLICT');let d=JSON.parse(r.data);if(write&&(d.archived||d.settlement56))throw Error('LOCKED');return {r,d}}
function save601_(u,r,d,a){let v=Number(r.version)+1;sheetV60_('Records').getRange(r._row,3,1,4).setValues([[v,JSON.stringify(d),new Date(),u.email]]);auditV60_(u,a,r.id,r.unitId);return {id:String(r.id),version:v,data:d}}
function unit601_(u,v){let id=u.role.startsWith('UNIT_')?u.unitId:id601_(v);if(!scopeV60_(u,id)||!readV60_('Units').some(x=>String(x.id)===id&&truthV60_(x.active)))throw Error('FORBIDDEN');return id}
function list601_(u,n){return readV60_(n).filter(x=>scopeV60_(u,x.unitId)).map(x=>Object.fromEntries(Object.entries(x).filter(([k])=>k!=='_row').map(([k,v])=>[k,v instanceof Date?v.toISOString():v])))}
function folder601_(){let id=PropertiesService.getScriptProperties().getProperty('EVIDENCE_FOLDER_ID');if(!id)throw Error('DRIVE_NOT_CONFIGURED');let f=DriveApp.getFolderById(id);if(f.getSharingAccess()!==DriveApp.Access.PRIVATE)throw Error('DRIVE_NOT_PRIVATE');return f}
function signature601_(a,m){const b=i=>(a[i]||0)&255;return m==='image/jpeg'&&b(0)===255&&b(1)===216&&b(2)===255||m==='image/png'&&[137,80,78,71,13,10,26,10].every((v,i)=>b(i)===v)||m==='application/pdf'&&[37,80,68,70,45].every((v,i)=>b(i)===v)}
function dispatch601_(u,q){switch(q.action){
case 'progress.save':return lock601_(()=>{let {r,d}=rec601_(u,q,true);if(d.approval!=='APPROVED'||d.ngayNghiemThu)throw Error('INVALID_STATE');let n=amount601_(q.progress);if(n>100||n<Number(d.progress53||0))throw Error('INVALID_PROGRESS');let date=date601_(q.date);if(date>today601_()||d.ngayDuyet&&date<d.ngayDuyet||d.ngayKhoiCong&&date<d.ngayKhoiCong)throw Error('INVALID_DATE');d.ngayKhoiCong=d.ngayKhoiCong||date;d.progress53=n;d.trangThai=n===100?'Chờ nghiệm thu':'Đang thi công';return save601_(u,r,d,q.action)});
case 'finance.budget':province601_(u);return lock601_(()=>{let {r,d}=rec601_(u,q,true);if(d.approval!=='APPROVED')throw Error('INVALID_STATE');let t=amount601_(q.tinh),c=amount601_(q.coSo),o=amount601_(q.doiUng);if(t+c<Number(d.kinhPhiDaCap||0))throw Error('EXCEEDS_BUDGET');Object.assign(d,{kinhPhiTinh:t,kinhPhiCoSo:c,doiUng:o});return save601_(u,r,d,q.action)});
case 'finance.list':return list601_(u,'Transactions');
case 'finance.post':province601_(u);return lock601_(()=>{let {r,d}=rec601_(u,q,true);if(d.approval!=='APPROVED'||!['cap','paid'].includes(q.kind))throw Error('INVALID_STATE');let amount=amount601_(q.amount),date=date601_(q.date),ref=text601_(q.ref,100);if(!amount||!ref||date>today601_())throw Error('INVALID_REQUEST');let tx=readV60_('Transactions').filter(x=>String(x.recordId)===String(r.id));if(tx.some(x=>String(x.ref)===ref))throw Error('DUPLICATE_REF');let cap=tx.filter(x=>x.kind==='cap').reduce((n,x)=>n+Number(x.amount),0),paid=tx.filter(x=>x.kind==='paid').reduce((n,x)=>n+Number(x.amount),0);if(cap!==Number(d.kinhPhiDaCap||0)||paid!==Number(d.kinhPhiGiaiNgan||0))throw Error('LEDGER_MISMATCH');if(q.kind==='cap')cap+=amount;else paid+=amount;if(cap>Number(d.kinhPhiTinh||0)+Number(d.kinhPhiCoSo||0)||paid>cap)throw Error('EXCEEDS_BUDGET');sheetV60_('Transactions').appendRow([Utilities.getUuid(),r.id,r.unitId,q.kind,amount,date,ref,u.email]);d.kinhPhiDaCap=cap;d.kinhPhiGiaiNgan=paid;return save601_(u,r,d,q.action)});
case 'evidence.list':{let {r}=rec601_(u,q,false);return list601_(u,'Evidence').filter(x=>String(x.recordId)===String(r.id)).map(({fileId,...x})=>x)}
case 'evidence.upload':return lock601_(()=>{let {r}=rec601_(u,q,true);let mime=q.mime,name=text601_(q.name,150);if(!['image/png','image/jpeg','application/pdf'].includes(mime)||typeof q.base64!=='string'||q.base64.length>7000000)throw Error('INVALID_FILE');let bytes=Utilities.base64Decode(q.base64);if(!bytes.length||bytes.length>5*1024*1024||!signature601_(bytes,mime))throw Error('INVALID_FILE');let file=folder601_().createFile(Utilities.newBlob(bytes,mime,name)),id=Utilities.getUuid();try{sheetV60_('Evidence').appendRow([id,r.id,r.unitId,file.getId(),name,mime,bytes.length])}catch(e){file.setTrashed(true);throw e}auditV60_(u,q.action,r.id,r.unitId);return {id}});
case 'evidence.download':{let {r}=rec601_(u,q,false);let x=readV60_('Evidence').find(x=>String(x.id)===String(q.evidenceId)&&String(x.recordId)===String(r.id));if(!x)throw Error('NOT_FOUND');let file=DriveApp.getFileById(x.fileId),parents=file.getParents(),folder=folder601_().getId(),allowed=false;while(parents.hasNext())if(parents.next().getId()===folder)allowed=true;if(!allowed||file.getSharingAccess()!==DriveApp.Access.PRIVATE)throw Error('DRIVE_NOT_PRIVATE');let blob=file.getBlob(),bytes=blob.getBytes();if(bytes.length>5*1024*1024||!signature601_(bytes,x.mime))throw Error('INVALID_FILE');return {name:x.name,mime:x.mime,base64:Utilities.base64Encode(bytes)}}
case 'completion.accept':case 'completion.handover':case 'completion.settle':case 'completion.archive':province601_(u);return lock601_(()=>{let {r,d}=rec601_(u,q,false);if(Number(q.version)!==Number(r.version)||d.archived)throw Error('LOCKED_OR_CONFLICT');if(d.approval!=='APPROVED')throw Error('INVALID_STATE');let date=date601_(q.date),ref=text601_(q.ref,100);if(date>today601_()||!ref)throw Error('INVALID_REQUEST');let ev=readV60_('Evidence').filter(x=>String(x.recordId)===String(r.id));if(q.action==='completion.accept'){if(d.settlement56||d.ngayNghiemThu||d.progress53!==100||!d.ngayKhoiCong||date<d.ngayKhoiCong||!ev.length)throw Error('INVALID_STATE');d.ngayNghiemThu=date;d.accept561={date,ref,result:'pass'}}else if(q.action==='completion.handover'){if(!d.ngayNghiemThu||d.ngayBanGiao||date<d.ngayNghiemThu)throw Error('INVALID_STATE');d.ngayBanGiao=date;d.handover561={date,ref};d.trangThai='Đã nghiệm thu, bàn giao'}else if(q.action==='completion.settle'){if(!d.ngayBanGiao||d.settlement56||date<d.ngayBanGiao||Number(d.kinhPhiDaCap||0)!==Number(d.kinhPhiGiaiNgan||0)||Number(d.kinhPhiTinh||0)+Number(d.kinhPhiCoSo||0)!==Number(d.kinhPhiGiaiNgan||0))throw Error('INVALID_STATE');d.settlement56={date,ref}}else{if(!d.settlement56||date<d.settlement56.date)throw Error('INVALID_STATE');d.archived=true;d.archive561={date,ref}}return save601_(u,r,d,q.action)});
case 'plans.list':return list601_(u,'Plans');
case 'plans.set':province601_(u);return lock601_(()=>{let unit=unit601_(u,q.unitId),year=String(q.year),target=amount601_(q.target);if(!/^\d{4}$/.test(year)||target>1000000)throw Error('INVALID_REQUEST');let a=readV60_('Plans').find(x=>String(x.unitId)===unit&&String(x.year)===year),vals=[a?.id||Utilities.getUuid(),unit,year,target];if(a)sheetV60_('Plans').getRange(a._row,1,1,4).setValues([vals]);else sheetV60_('Plans').appendRow(vals);auditV60_(u,q.action,'',unit);return true});
case 'tasks.list':return list601_(u,'Tasks').map(x=>({id:String(x.id),unitId:String(x.unitId),...JSON.parse(x.data)}));
case 'tasks.create':province601_(u);return lock601_(()=>{let unit=unit601_(u,q.unitId),note=text601_(q.note,1000),due=date601_(q.due);if(!note||due<today601_())throw Error('INVALID_REQUEST');let id=Utilities.getUuid();sheetV60_('Tasks').appendRow([id,unit,JSON.stringify({note,due,state:0,version:1})]);auditV60_(u,q.action,id,unit);return id});
case 'tasks.next':return lock601_(()=>{if(!writerV60_(u))throw Error('FORBIDDEN');let t=readV60_('Tasks').find(x=>String(x.id)===String(q.id));if(!t||!scopeV60_(u,t.unitId))throw Error('NOT_FOUND');let d=JSON.parse(t.data);if(d.state>=3||d.version!==q.version)throw Error('INVALID_STATE');if(d.state===2){d.result=text601_(q.result,1000);if(!d.result)throw Error('REQUIRED_FIELDS')}d.state++;d.version++;sheetV60_('Tasks').getRange(t._row,3).setValue(JSON.stringify(d));auditV60_(u,q.action,t.id,t.unitId);return d});
case 'reports.list':return list601_(u,'Reports');
case 'reports.submit':return lock601_(()=>{if(!writerV60_(u))throw Error('FORBIDDEN');let unit=unit601_(u,q.unitId),year=String(q.year||''),month=String(q.month||'');if(!/^\d{4}$/.test(year)||month&&!/^(0[1-9]|1[0-2])$/.test(month))throw Error('INVALID_PERIOD');let period=year+(month?'-'+month:''),a=readV60_('Reports').filter(x=>String(x.unitId)===unit&&String(x.period)===period).sort((a,b)=>Number(b.revision)-Number(a.revision)),last=a[0];if(last&&last.status!=='SUPPLEMENT')throw Error('INVALID_STATE');let data=reportV60_(u,{unitId:unit,year,month});let id=Utilities.getUuid();sheetV60_('Reports').appendRow([id,unit,period,last?Number(last.revision)+1:1,JSON.stringify({summary:data.summary,date:today601_(),previous:last?.id||null}),'SUBMITTED']);auditV60_(u,q.action,id,unit);return id});
case 'reports.review':province601_(u);return lock601_(()=>{let r=readV60_('Reports').find(x=>String(x.id)===String(q.id));if(!r||r.status!=='SUBMITTED'||!['APPROVED','SUPPLEMENT'].includes(q.decision))throw Error('INVALID_STATE');let d=JSON.parse(r.data);d.reviewNote=text601_(q.note||'',1000);if(q.decision==='SUPPLEMENT'&&!d.reviewNote)throw Error('REQUIRED_FIELDS');sheetV60_('Reports').getRange(r._row,5,1,2).setValues([[JSON.stringify(d),q.decision]]);auditV60_(u,q.action,r.id,r.unitId);return true});
case 'units.add':admin601_(u);return lock601_(()=>{let id=id601_(q.unitId),name=text601_(q.name,100);if(!name||readV60_('Units').some(x=>String(x.id)===id||String(x.name)===name))throw Error('DUPLICATE');sheetV60_('Units').appendRow([id,name,true]);auditV60_(u,q.action,id,id);return true});
case 'users.list':admin601_(u);return readV60_('Users').map(({_row,...x})=>x);
case 'audit.list':admin601_(u);return list601_(u,'Audit').slice(-200).reverse();
case 'reports.office':return office602_(u,q);
case 'notifications.list':return notices602_(u);
case 'backup.full':admin601_(u);return backup602_(u);
case 'backup.export':admin601_(u);return lock601_(()=>{let data={schema:'NDK-V601-PILOT',date:new Date().toISOString(),tables:{}};Object.keys(V60_SCHEMA).forEach(n=>data.tables[n]=readV60_(n).map(({_row,...x})=>Object.fromEntries(Object.entries(x).map(([k,v])=>[k,v instanceof Date?v.toISOString():v]))));auditV60_(u,q.action,'','');return data});
default:throw Error('NOT_IMPLEMENTED')}}

function notices602_(u){let a=reportV60_(u,{}).records,out=[],now=today601_();for(let r of a){let d=r.data;if(d.archived)continue;let add=(text,level)=>out.push({recordId:r.id,unitId:r.unitId,text,level});if(d.approval==='REVIEW')add('Chờ thẩm định','medium');if(d.approval==='SUPPLEMENT')add('Cần bổ sung hồ sơ','medium');if(d.hanHoanThanh&&d.hanHoanThanh<now&&!d.ngayBanGiao)add('Quá hạn xây dựng','high');if(d.progress53===100&&!d.ngayNghiemThu)add('Chờ nghiệm thu','medium');if(d.ngayNghiemThu&&!d.ngayBanGiao)add('Chờ bàn giao','medium');if(d.ngayBanGiao&&!d.settlement56)add('Chờ quyết toán','medium')}for(let t of list601_(u,'Tasks')){let d=JSON.parse(t.data);if(d.state<3&&Date.parse(d.due)-Date.parse(now)<=7*86400000)out.push({recordId:t.id,unitId:t.unitId,text:'Nhiệm vụ '+(d.due<now?'quá hạn':'sắp đến hạn')+': '+d.note,level:d.due<now?'high':'medium'})}return out}
function xml602_(s){return String(s??'').replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g,'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[c]))}
