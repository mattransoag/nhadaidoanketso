function backup602_(u){return lock601_(()=>{let data={schema:'NDK-V602-PILOT',date:new Date().toISOString(),tables:{},files:[]};Object.keys(V60_SCHEMA).forEach(n=>data.tables[n]=readV60_(n).map(({_row,...x})=>Object.fromEntries(Object.entries(x).map(([k,v])=>[k,v instanceof Date?v.toISOString():v]))));let total=0;if(data.tables.Evidence.length){let folder=folder601_().getId();for(let x of data.tables.Evidence){let f=DriveApp.getFileById(x.fileId),p=f.getParents(),ok=false;while(p.hasNext())if(p.next().getId()===folder)ok=true;if(!ok||f.getSharingAccess()!==DriveApp.Access.PRIVATE)throw Error('DRIVE_NOT_PRIVATE');total+=f.getSize();if(total>10*1024*1024)throw Error('BACKUP_LIMIT');let b=f.getBlob().getBytes();if(!signature601_(b,x.mime))throw Error('INVALID_FILE');data.files.push({id:x.id,name:x.name,mime:x.mime,base64:Utilities.base64Encode(b)})}}auditV60_(u,'backup.full','','');return data})}
